<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.2.7：启动公告弹窗布局
    - 标题
    - 公告内容（免责声明）
    - 「永久不再接收」勾选框
    - 确定 / 退出 两个按钮
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FF101010">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="免责声明"
        android:textColor="#FF1ED760"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvAnnouncementContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFCCCCCC"
            android:textSize="13.5sp"
            android:lineSpacingExtra="4dp"
            android:text="本软件仅供技术学习与交流，所有音乐内容来自搜索引擎公开结果，版权归原作者所有。本软件不存储任何音乐文件，仅提供搜索与播放功能。\n\n请于 24 小时内停止播放受版权保护的内容，如本软件侵犯了您的合法权益，请联系我们删除。\n\n使用本软件即表示您已阅读并同意以上声明。" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <CheckBox
        android:id="@+id/cbNeverShow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="永久不再接收"
        android:textColor="#FFAAAAAA"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="退出"
            android:textColor="#FFCCCCCC"
            android:background="#FF1F1F1F"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="确定"
            android:textColor="#FF000000"
            android:background="#FF1ED760" />
    </LinearLayout>
</LinearLayout>
