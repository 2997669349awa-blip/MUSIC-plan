<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV 设备特性：leanback 设为非必需，兼容海尔等定制安卓电视 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- 声明支持遥控器 -->
    <uses-feature android:name="android.hardware.remote_control" android:required="false" />

    <application
        android:banner="@drawable/ic_music_plugin_foreground"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 同时注册 LEANBACK_LAUNCHER 和 LAUNCHER，最大化兼容性 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.filemanager.OPEN_MUSIC_PLUGIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
