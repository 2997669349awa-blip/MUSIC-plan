<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_gradient">

    <!-- 顶部标题栏 v1.2.6：玻璃态深色 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FF0B0B0B"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tab 栏：本地 / 在线 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#FF0B0B0B"
        app:tabTextColor="#FF8A8A8A"
        app:tabSelectedTextColor="#FF1ED760"
        app:tabIndicatorColor="#FF1ED760"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorFullWidth="false"
        app:tabIndicator="@drawable/tab_indicator_pill"
        app:tabRippleColor="#001ED760"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/online_music" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/local_music" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorites" />
    </com.google.android.material.tabs.TabLayout>

    <!-- 搜索栏 -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_search_bar"
        android:layout_margin="14dp"
        android:padding="10dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#FFB3B3B3"
            android:contentDescription="@string/search" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:textColorHint="#FF666666"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:textCursorDrawable="@drawable/cursor_search"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 音质切换标签栏 -->
    <LinearLayout
        android:id="@+id/qualityBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvQualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quality"
            android:textColor="#FFAAAAAA"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupQuality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipStandard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_standard"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:checked="true" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_high"
                style="@style/Widget.MaterialComponents.Chip.Choice" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipLossless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quality_lossless"
                style="@style/Widget.MaterialComponents.Chip.Choice" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- 歌曲列表 v1.1.6：底部直接约束到 bottomBar，修复下半部分不显示的问题 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSongs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/qualityBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_music"
        android:textColor="#FF888888"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerSongs"
        app:layout_constraintBottom_toBottomOf="@id/recyclerSongs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 歌词面板 v1.2.7：玻璃态背景 + 顶/底渐变遮罩淡入淡出 -->
    <FrameLayout
        android:id="@+id/lyricPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_lyric_panel"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/qualityBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/lyricScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/tvLyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="80dp"
                android:paddingBottom="80dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="#FFCCCCCC"
                android:textSize="16sp"
                android:lineSpacingExtra="10dp"
                android:gravity="center" />
        </ScrollView>

        <!-- 顶部渐变遮罩（让歌词从顶部淡入） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_lyric_fade_top" />

        <!-- 底部渐变遮罩（让歌词向底部淡出） -->
        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_lyric_fade_bottom" />
    </FrameLayout>

    <!-- 底部播放控制栏 v1.2.7：玻璃态 + 顶部分隔线 + 圆角封面 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_bar"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="52dp">

            <!-- v1.2.7：专辑封面圆角 + 微光边框（半径在代码里通过 outlineProvider 设为 12f） -->
            <ImageView
                android:id="@+id/imgAlbumArt"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_media_play"
                android:background="@drawable/bg_album_placeholder"
                android:contentDescription="@string/lyrics" />

            <TextView
                android:id="@+id/tvCurrentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingStart="4dp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/tv_button_bg"
                android:src="@drawable/ic_star_outline"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/favorite" />

            <ImageButton
                android:id="@+id/btnCast"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_menu_share"
                android:tint="#FFAAAAAA"
                android:layout_marginStart="4dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/cast" />
        </LinearLayout>

        <!-- 进度条行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF8A8A8A"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:text="00:00" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FF1ED760"
                android:progressBackgroundTint="#33FFFFFF"
                android:thumbTint="#FF1ED760" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF8A8A8A"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:text="00:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FF1ED760"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/prev" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFFFFFFF"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/play" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FF1ED760"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/next" />

            <ImageButton
                android:id="@+id/btnMode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#FFAAAAAA"
                android:layout_marginStart="6dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/mode_loop" />

            <!-- v1.2.3：恢复 MV/PV 按钮 -->
            <ImageButton
                android:id="@+id/btnMv"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFAAAAAA"
                android:layout_marginStart="6dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/lyrics" />

            <ImageButton
                android:id="@+id/btnLyrics"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/tv_button_bg"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="#FFAAAAAA"
                android:layout_marginStart="6dp"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/lyrics" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
